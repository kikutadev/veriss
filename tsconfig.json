{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noEmitOnError": true,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "rootDir": "."
  },
  "include": [
    "packages/**/*.mts",
    "types/**/*.d.ts",
    "packages/veriss/src/layout-contracts.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/*.d.mts"
  ]
}
