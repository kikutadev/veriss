{
  "name": "@mizchi/veriss-vue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Vue 3 SFC adapter for @mizchi/veriss: v-if/v-show/v-for/:class branches as states, scoped styles.",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    }
  },
  "dependencies": {
    "vue": "3.5.44",
    "@babel/parser": "7.29.12"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@mizchi/veriss-adapter-core": "*"
  },
  "devDependencies": {
    "@mizchi/veriss-adapter-core": "workspace:*"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.js",
    "src/**/*.d.mts",
    "src/**/*.d.ts",
    "fixtures/"
  ]
}
